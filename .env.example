# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Auth.js (NextAuth v5) secret used to sign internal tokens (e.g. CSRF).
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of this app, used by Auth.js and for building email links.
# e.g. http://localhost:3000 in development.
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign the short-lived, verify-email-scoped token issued
# after signup (JWT via `jose`). Generate with: openssl rand -base64 32
VERIFY_EMAIL_TOKEN_SECRET=

# Upstash Redis REST credentials, used for rate limiting.
# From the Upstash console: Database -> REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend API key for transactional email (signup verification, password reset).
# From the Resend dashboard: API Keys.
RESEND_API_KEY=

# "From" address used on outgoing Resend emails. Must be a verified
# sender/domain in the Resend dashboard.
EMAIL_FROM=Application Manager Track <onboarding@resend.dev>
